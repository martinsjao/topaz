{
	"name": "topaz",
	"private": true,
	"type": "module",
	"workspaces": [
		"apps/*",
		"packages/*"
	],
	"scripts": {
		"dev": "bun --filter api --filter web dev",
		"db:up": "docker compose --env-file .env -f infra/compose.yaml up -d --wait",
		"db:down": "docker compose --env-file .env -f infra/compose.yaml down",
		"db:reset": "docker compose --env-file .env -f infra/compose.yaml down -v && docker compose --env-file .env -f infra/compose.yaml up -d --wait",
		"db:generate": "bun --filter @topaz/db generate",
		"db:migrate": "bun --filter @topaz/db migrate",
		"db:push": "bun --filter @topaz/db push",
		"db:seed": "bun --filter @topaz/db seed"
	},
	"devDependencies": {
		"@types/bun": "latest"
	}
}
